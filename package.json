{
  "private": true,
  "name": "nebula-chat",
  "version": "7.18.1",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": ">=12"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "backend": "pnpm --filter @nebula-chat/server",
    "frontend": "pnpm --filter @nebula-chat/client",
    "worker": "pnpm --filter @nebula-chat/worker",
    "nebula": "tsx --tsconfig apps/cli/tsconfig.json apps/cli/src/bin.ts",
    "lint": "eslint --report-unused-disable-directives --max-warnings=0 .",
    "lint:fix": "eslint --report-unused-disable-directives --max-warnings=0 . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:libs": "turbo run build --filter=./libs/*...",
    "knip": "knip",
    "catalog:stamp": "tsx scripts/stamp-catalogs.ts",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "skills:check": "tsx scripts/check-skills.ts",
    "deps:check": "depcruise apps/server/src apps/client/src apps/worker/src apps/cli/src --config .dependency-cruiser.cjs --ignore-known --output-type err",
    "deps:baseline": "depcruise-baseline apps/server/src apps/client/src apps/worker/src apps/cli/src --config .dependency-cruiser.cjs",
    "deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type mermaid"
  },
  "dependencies": {
    "only-allow": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jiti": "^2.6.1",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "tsx": "catalog:",
    "turbo": "^2.11.11",
    "typescript": "catalog:"
  }
}
