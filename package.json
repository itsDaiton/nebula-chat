{
  "private": true,
  "name": "nebula-chat",
  "version": "5.18.0",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": ">=12"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "backend": "pnpm --filter @nebula-chat/server",
    "frontend": "pnpm --filter @nebula-chat/client",
    "worker": "pnpm --filter @nebula-chat/worker",
    "nebula": "tsx --tsconfig apps/cli/tsconfig.json apps/cli/src/bin.ts",
    "lint": "eslint --report-unused-disable-directives --max-warnings=0 .",
    "lint:fix": "eslint --report-unused-disable-directives --max-warnings=0 . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:libs": "turbo run build --filter=./libs/*...",
    "knip": "knip",
    "catalog:stamp": "tsx scripts/stamp-model-catalog.ts",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage"
  },
  "dependencies": {
    "only-allow": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jiti": "^2.6.1",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "tsx": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
