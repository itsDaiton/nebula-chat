# Local infrastructure for docker-compose.yml (Postgres + Redis containers).
# `podman compose` reads this file automatically from the repo root; the apps
# never read it. Copy to `.env` and keep it out of git.
#
# The credentials must match the connection strings in apps/nebula-chat-server/.env:
#   DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5332/<POSTGRES_DB>
#   REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6380

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

REDIS_PASSWORD=<your-redis-password-here>
