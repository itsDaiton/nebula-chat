{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    // tsup's dts pass injects `baseUrl`, which TypeScript 6 rejects outright
    // (TS5101) rather than warning. Matches libs/otel/tsconfig.json.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "tsup.config.ts"]
}
