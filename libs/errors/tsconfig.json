{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Isomorphic: imported by the browser client as well as the server, so it
    // must not reach for Node APIs. No `node` types keeps that honest.
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src", "tsdown.config.mts"]
}
