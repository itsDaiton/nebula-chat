{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    // tsup's dts pass injects `baseUrl`, which TypeScript 6 rejects outright
    // (TS5101) rather than warning. Matches apps/nebula-chat-server/tsconfig.json.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "drizzle.config.ts", "tsup.config.ts"]
}
