{
  "name": "@nebula-chat/db",
  "version": "0.5.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenvx run -f ../../apps/nebula-chat-server/.env --ignore=MISSING_ENV_FILE -- drizzle-kit generate",
    "db:migrate": "dotenvx run -f ../../apps/nebula-chat-server/.env --ignore=MISSING_ENV_FILE -- tsx src/migrate.ts",
    "db:baseline": "dotenvx run -f ../../apps/nebula-chat-server/.env --ignore=MISSING_ENV_FILE -- tsx src/baseline.ts",
    "db:push": "dotenvx run -f ../../apps/nebula-chat-server/.env --ignore=MISSING_ENV_FILE -- drizzle-kit push",
    "db:studio": "dotenvx run -f ../../apps/nebula-chat-server/.env --ignore=MISSING_ENV_FILE -- drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.0",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
