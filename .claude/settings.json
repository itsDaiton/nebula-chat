{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "deniedMcpServers": [
    { "serverName": "Booking_com" },
    { "serverName": "Spotify" },
    { "serverName": "PubMed" },
    { "serverName": "Microsoft_Learn" },
    { "serverName": "Excalidraw" },
    { "serverName": "Notion" },
    { "serverName": "Gmail" },
    { "serverName": "Google_Calendar" },
    { "serverName": "Google_Docs" },
    { "serverName": "Google_Drive" },
    { "serverName": "Google_Sheets" },
    { "serverName": "Google_Slides" },
    { "serverName": "claude.ai Booking.com" },
    { "serverName": "claude.ai Spotify" },
    { "serverName": "claude.ai PubMed" },
    { "serverName": "claude.ai Microsoft Learn" },
    { "serverName": "claude.ai Excalidraw" },
    { "serverName": "claude.ai Notion" },
    { "serverName": "claude.ai Gmail" },
    { "serverName": "claude.ai Google Calendar" },
    { "serverName": "claude.ai Google Docs" },
    { "serverName": "claude.ai Google Drive" },
    { "serverName": "claude.ai Google Sheets" },
    { "serverName": "claude.ai Google Slides" }
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-changed-files.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-dangerous-bash.sh"
          }
        ]
      }
    ]
  }
}
