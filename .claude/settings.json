{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_THRIFTY_SONIC": "0"
  },
  "allowedMcpServers": [
    { "serverName": "shadcn" },
    { "serverName": "better-auth" },
    { "serverName": "context7" },
    { "serverName": "langchain-docs" },
    { "serverName": "playwright" },
    { "serverName": "redis-local" },
    { "serverName": "github" },
    { "serverName": "claude-code-remote" },
    { "serverName": "ccd_session" },
    { "serverName": "Claude_Docs" },
    { "serverName": "Firecrawl" },
    { "serverName": "Grafana_Cloud" },
    { "serverName": "Supabase" },
    { "serverName": "Render" }
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-changed-files.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-dangerous-bash.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/typecheck-on-stop.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
