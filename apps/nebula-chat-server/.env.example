# Server
PORT=3000
SERVER_URL=http://localhost:3000
TRUST_PROXY=1
LOG_LEVEL=info
# Per-component levels, e.g. redis=debug,auth=warn (docs/logging.md)
LOG_LEVEL_OVERRIDES=
# Operator secret (32+ chars) for /api/internal/*, e.g. runtime log levels; leave unset to disable
OPERATOR_TOKEN=

# Client
CLIENT_URL=http://localhost:5173

# LLM providers — set at least one
OPENAI_API_KEY=<your-openai-api-key-here>
ANTHROPIC_API_KEY=<your-anthropic-api-key-here>

# Database — connection string used at runtime and by libs/db drizzle-kit commands
# (local container: postgresql://<POSTGRES_USER>@localhost:5332/<POSTGRES_DB>,
# with POSTGRES_PASSWORD from the root .env as the password segment after the user)
DATABASE_URL=<your-database-url-here>

# Redis connection string (local container: redis://:<REDIS_PASSWORD>@localhost:6380)
REDIS_URL=<your-redis-url-here>

# Auth (better-auth — @nebula-chat/auth)
# BETTER_AUTH_SECRET signs sessions and the session cookie cache — use a long random value.
BETTER_AUTH_SECRET=<your-better-auth-secret-here>
BETTER_AUTH_URL=http://localhost:3000
# Verification + reset email via Resend (ADR-0021). EMAIL_FROM needs a Resend-verified domain;
# `onboarding@resend.dev` only delivers to your own Resend account's address.
RESEND_API_KEY=<your-resend-api-key-here>
EMAIL_FROM=Nebula Chat <onboarding@resend.dev>
# Guest `user`-message cap before registration is required (ADR-0010).
GUEST_MESSAGE_ALLOWANCE=10
# Social sign-in (docs/auth.md). Set a provider's id AND secret to enable it; with both blank its button
# answers "unavailable". Register <BETTER_AUTH_URL>/api/auth/callback/<google|github> as the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Profile image storage in Supabase Storage (ADR-0022, README → Profile image storage). Set all three, or
# leave all blank to switch uploads off. The secret key is server-only. Local dev: PROFILE_IMAGE_BUCKET=profile-images-dev.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PROFILE_IMAGE_BUCKET=

# Observability (docs/logging.md). Traces and logs go to an OTLP endpoint only when one is set. Locally:
# `podman compose up -d otel-lgtm`, uncomment both, and open Grafana at http://localhost:3001.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_LOGS_EXPORTER=otlp
