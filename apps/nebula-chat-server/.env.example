# Server
PORT=3000
SERVER_URL=http://localhost:3000
TRUST_PROXY=1
LOG_LEVEL=info
# Per-component levels, e.g. redis=debug,auth=warn (docs/logging.md)
LOG_LEVEL_OVERRIDES=
# Operator secret (32+ chars) for /api/internal/*, e.g. runtime log levels; leave unset to disable
OPERATOR_TOKEN=

# Client
CLIENT_URL=http://localhost:5173

# LLM providers — set at least one
OPENAI_API_KEY=<your-openai-api-key-here>
ANTHROPIC_API_KEY=<your-anthropic-api-key-here>

# Database — connection string used at runtime and by libs/db drizzle-kit commands
DATABASE_URL=<your-database-url-here>

# Local Docker Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Production Redis
REDIS_URL=<your-redis-url-here>

# Local Redis
REDIS_PASSWORD=<your-redis-password-here>

# Auth (better-auth — @nebula-chat/auth)
# BETTER_AUTH_SECRET signs sessions and the session cookie cache — use a long random value.
BETTER_AUTH_SECRET=<your-better-auth-secret-here>
BETTER_AUTH_URL=http://localhost:3000
# Verification + reset email via Resend (ADR-0021). EMAIL_FROM needs a Resend-verified domain;
# `onboarding@resend.dev` only delivers to your own Resend account's address.
RESEND_API_KEY=<your-resend-api-key-here>
EMAIL_FROM=Nebula Chat <onboarding@resend.dev>
# Guest `user`-message cap before registration is required (ADR-0010).
GUEST_MESSAGE_ALLOWANCE=10
