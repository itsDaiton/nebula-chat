{
  "name": "@nebula-chat/server",
  "version": "4.9.0",
  "description": "Fastify API: auth, Sessions and Messages, and the SSE relay for the replies the worker produces",
  "packageManager": "pnpm@12.4.1",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "dotenvx run -f .env --ignore=MISSING_ENV_FILE -- node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsx src/scripts/generate-openapi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/under-pressure": "^9.2.1",
    "@nebula-chat/auth": "workspace:*",
    "@nebula-chat/contracts": "workspace:*",
    "@nebula-chat/db": "workspace:*",
    "@nebula-chat/errors": "workspace:*",
    "@nebula-chat/otel": "workspace:*",
    "@nebula-chat/redis": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "^5.12.6",
    "fastify-plugin": "^6.0.1",
    "fastify-zod-openapi": "^5.7.0",
    "sharp": "^0.35.5",
    "tiktoken": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "nodemon": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
