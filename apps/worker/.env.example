# Worker
# Only /health listens here (Render runs the worker as a free web service; ADR-0013).
PORT=3001
LOG_LEVEL=info
# Per-component levels, e.g. llm=debug,redis=warn (docs/logging.md)
LOG_LEVEL_OVERRIDES=
# Direct replies one instance produces at once
WORKER_CONCURRENCY=5
# Runs one instance executes at once, and each Run's limits
RUN_CONCURRENCY=3
RUN_TURN_CAP=6
RUN_PARALLEL_DELEGATES=4
RUN_TOKEN_BUDGET=60000
RUN_HANDOFF_THRESHOLD=0.85
RUN_DELEGATE_TIMEOUT_MS=60000
RUN_DELEGATE_TOOL_CALL_CAP=6
RUN_TIMEOUT_MS=300000
# The researcher's web_fetch: body size cap, timeout (searches too), redirects and returned text budget
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_TIMEOUT_MS=10000
WEB_FETCH_MAX_REDIRECTS=5
WEB_FETCH_MAX_CHARS=12000
# Seconds a reply stream outlives its end, for a dropped client to resume from
STREAM_TTL_SECONDS=3600

# LLM providers — set at least one. Only the worker holds them; the server has none.
OPENAI_API_KEY=<your-openai-api-key-here>
ANTHROPIC_API_KEY=<your-anthropic-api-key-here>
# Web search (Tavily, free tier). Worker only; unset, local searches go keyless (rate-limited) and production's fail.
TAVILY_API_KEY=<your-tavily-api-key-here>

# The same Postgres and Redis the server uses (see apps/server/.env.example)
DATABASE_URL=<your-database-url-here>
REDIS_URL=<your-redis-url-here>
