{
  "name": "@nebula-chat/worker",
  "version": "1.12.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "main": "dist/src/worker.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/resources', 'dist/src/resources', { recursive: true })\"",
    "start": "dotenvx run -f .env --ignore=MISSING_ENV_FILE -- node dist/src/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.13",
    "@langchain/core": "^1.2.20",
    "@langchain/langgraph": "^1.5.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.0",
    "@langchain/openai": "^1.6.3",
    "@nebula-chat/contracts": "workspace:*",
    "@nebula-chat/db": "workspace:*",
    "@nebula-chat/errors": "workspace:*",
    "@nebula-chat/otel": "workspace:*",
    "@nebula-chat/redis": "workspace:*",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "html-to-text": "^10.0.1",
    "langchain": "^1.5.18",
    "p-limit": "^7.3.3",
    "tiktoken": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "nodemon": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
