{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "component": "nebula-chat",
      "include-component-in-tag": true,
      "exclude-paths": ["apps/**", "libs/**", "openapi/**"]
    },
    "apps/nebula-chat-client": {
      "release-type": "node",
      "include-component-in-tag": true
    },
    "apps/nebula-chat-server": {
      "release-type": "node",
      "include-component-in-tag": true
    },
    "libs/auth": {
      "release-type": "node",
      "component": "nebula-chat-auth",
      "include-component-in-tag": true
    },
    "libs/db": {
      "release-type": "node",
      "component": "nebula-chat-db",
      "include-component-in-tag": true
    },
    "libs/errors": {
      "release-type": "node",
      "component": "nebula-chat-errors",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true
    },
    "libs/langchain": {
      "release-type": "node",
      "component": "nebula-chat-langchain",
      "include-component-in-tag": true
    },
    "libs/otel": {
      "release-type": "node",
      "component": "nebula-chat-otel",
      "include-component-in-tag": true
    },
    "libs/redis": {
      "release-type": "node",
      "component": "nebula-chat-redis",
      "include-component-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true
    },
    "openapi": {
      "release-type": "node",
      "include-component-in-tag": true,
      "extra-files": [
        {
          "type": "yaml",
          "path": "openapi.yaml",
          "jsonpath": "$.info.version"
        }
      ]
    }
  }
}
