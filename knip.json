{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": [".claude/skills/**"],
  "workspaces": {
    "apps/nebula-chat-client": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreFiles": ["src/libs/api/generated/**"],
      "ignoreIssues": {
        "src/libs/api/generated/**": ["exports", "types"]
      }
    },
    "apps/nebula-chat-server": {
      "project": ["src/**/*.ts"]
    },
    "libs/db": {
      "project": ["src/**/*.ts"],
      "drizzle": false
    },
    "libs/errors": {
      "project": ["src/**/*.ts"]
    },
    "libs/langchain": {
      "project": ["src/**/*.ts"]
    },
    "libs/otel": {
      "project": ["src/**/*.ts"]
    }
  }
}
